# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser (Supabase → service_role key)
SUPABASE_SERVICE_ROLE_KEY=

# Database connection for running migrations (Project Settings → Database → Connection string → URI)
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=
