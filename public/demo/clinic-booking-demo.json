            "type": "dropdown",
            "key": "department",
            "label": "Department",
            "props": {
              "required": "Required",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "Select a department to continue",
              "source": "Static list",
              "options": ["General Medicine", "Cardiology", "Orthopedics", "Dermatology", "Pediatrics", "ENT"],
              "allowOther": "No",
              "searchable": "Yes"
            }
          },
          {
            "id": "f-doctor",
            "type": "lookup",
            "key": "preferred_doctor",
            "label": "Preferred doctor",
            "props": {
              "required": "Optional",
              "editability": "Conditionally editable",
              "editCond": "department is selected",
              "visibility": "Conditional",
              "visCond": "department ≠ Emergency",
              "errorMsg": "Select a doctor from the list or leave blank for auto-assignment",
              "dataset": "Doctors API — filtered by department + availability on preferred_date",
              "minChars": "2"
            }
          },
          {
            "id": "f-visit-type",
            "type": "radio",
