            "props": {
              "required": "Optional",
              "editability": "Always editable",
              "visibility": "Conditional",
              "visCond": "visit_type = In-person visit",
              "errorMsg": "Upload a clear photo or PDF of the insurance card",
              "types": "pdf, jpg, png",
              "maxSize": "5",
              "multiFile": "Single"
            }
          },
          {
            "id": "f-notes",
            "type": "longText",
            "key": "additional_notes",
            "label": "Additional notes for the doctor",
            "props": {
              "required": "Optional",
              "defaultValue": "",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "Keep notes under 500 characters",
              "maxLen": "500"
            }
          },
          {
            "id": "f-wait-time",
            "type": "calculated",
            "key": "estimated_wait",
            "label": "Estimated wait time",
            "props": {
              "required": "Optional",
              "editability": "Read-only",
              "visibility": "Always visible",
              "formula": "AVG(doctor.queue_length) × slot_duration for selected department + preferred_date"
            }
          },
          {
            "id": "f-medications",
