              "required": "Required",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "Choose in-person or telehealth",
              "options": ["In-person visit", "Telehealth (video call)"]
            }
          },
          {
            "id": "f-symptoms",
            "type": "multiselect",
            "key": "symptoms",
            "label": "Symptoms or concerns",
            "props": {
              "required": "Optional",
              "editability": "Always editable",
              "visibility": "Always visible",
              "options": ["Fever", "Pain", "Follow-up visit", "Lab results review", "Prescription refill", "Other"],
              "minSel": "0",
              "maxSel": "5",
              "allowOther": "Yes"
            }
          },
          {
            "id": "f-fee",
            "type": "currency",
            "key": "consultation_fee",
