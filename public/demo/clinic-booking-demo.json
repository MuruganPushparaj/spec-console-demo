  "workspace": {
    "forms": [
      {
        "id": "demo-booking-form",
        "projectId": "demo-clinic",
        "name": "Appointment booking & intake",
        "notes": "Problem this form solves: Patients currently book appointments by phone, leading to double-bookings, missing insurance details, and long hold times. This form captures everything needed to schedule a visit, verify eligibility, and route the patient to the right department — in one guided flow.\n\nOpen questions for client:\n• Should telehealth slots share the same calendar as in-person?\n• Is insurance mandatory before booking, or optional at check-in?",
        "updatedAt": 1727635200000,
        "fields": [
          {
            "id": "f-patient-name",
            "type": "shortText",
            "key": "patient_full_name",
            "label": "Patient full name",
            "props": {
              "required": "Required",
              "defaultValue": "",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "Please enter the patient's legal name as on ID",
              "minLen": "2",
              "maxLen": "120",
              "pattern": "Letters only"
            }
          },
          {
            "id": "f-email",
            "type": "email",
            "key": "contact_email",
            "label": "Contact email",
            "props": {
              "required": "Required",
              "defaultValue": "",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "Enter a valid email — confirmation is sent here",
              "multi": "Single",
              "domainPolicy": "Any domain"
            }
          },
          {
            "id": "f-phone",
            "type": "phone",
            "key": "mobile_number",
            "label": "Mobile number",
            "props": {
              "required": "Required",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "Enter a valid 10-digit mobile number",
              "region": "India — 10 digits",
              "cc": "Yes"
            }
          },
          {
            "id": "f-age",
            "type": "number",
            "key": "patient_age",
            "label": "Patient age",
            "props": {
              "required": "Required",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "Age must be between 0 and 120",
              "min": "0",
              "max": "120",
              "decimals": "Integer only",
              "negative": "No",
              "unit": "years"
            }
          },
          {
            "id": "f-appt-date",
            "type": "date",
            "key": "preferred_date",
            "label": "Preferred appointment date",
            "props": {
              "required": "Required",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "Choose a date within the next 30 days",
              "minDate": "Today",
              "maxDate": "Relative",
              "maxDateVal": "+30d",
              "time": "Date + time"
            }
          },
          {
