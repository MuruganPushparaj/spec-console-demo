                  "maxDate": "Today",
                  "timeOpt": "Date only"
                }
              ]
            }
          },
          {
            "id": "f-terms",
            "type": "checkbox",
            "key": "terms_accepted",
            "label": "I agree to the clinic terms and privacy policy",
            "props": {
              "required": "Required",
              "editability": "Always editable",
              "visibility": "Always visible",
              "errorMsg": "You must accept the terms to book",
              "defaultState": "Unchecked / off"
            }
          }
        ],
        "buttons": [
          {
            "id": "btn-save-draft",
            "notes": "Draft saves locally for 7 days — patient can resume from email link.",
            "props": {
              "label": "Save draft",
              "style": "Secondary",
              "enabledWhen": "Always",
              "validates": "1. Patient name format (if filled)\n2. Email format (if filled)\n— no required-field check for draft",
              "action": "POST /api/appointments/draft — upsert partial form state",
              "onSuccess": "Toast: 'Draft saved' + update last-saved timestamp in header",
              "onError": "Toast: 'Could not save — check connection' + keep form data in browser",
              "confirm": "No"
            }
          },
          {
            "id": "btn-book",
            "notes": "Primary CTA — triggers slot hold for 10 minutes while payment completes.",
            "props": {
              "label": "Book appointment",
              "style": "Primary",
              "enabledWhen": "All required fields valid",
              "validates": "1. All required fields present\n2. Email + phone format\n3. preferred_date within allowed window\n4. terms_accepted = true\n5. Doctor availability check (API)\n6. Insurance file type/size (if uploaded)",
              "action": "POST /api/appointments — create booking + hold slot + send confirmation email/SMS",
              "onSuccess": "Redirect to /booking/confirmation?id={bookingId} + show summary + calendar invite",
              "onError": "Inline field errors for validation failures; modal for slot-unavailable with 'Pick another time' CTA",
              "confirm": "Yes"
            }
          },
          {
            "id": "btn-cancel",
            "props": {
              "label": "Cancel",
              "style": "Link",
              "enabledWhen": "Always",
              "validates": "None",
              "action": "Navigate to /departments — discard unsaved changes",
              "onSuccess": "Return to department listing",
              "onError": "If unsaved changes: show 'Discard changes?' confirmation dialog",
              "confirm": "No"
            }
          }
